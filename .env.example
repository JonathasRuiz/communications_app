# Example environment configuration for communications-app
# Copy this file to .env and customize for your setup

# ================================================
# SERVER CONFIGURATION
# ================================================

# Main server URL (hostname or IP address)
REACT_APP_SERVER_URL=localhost

# Main server port
REACT_APP_SERVER_PORT=8080

# ================================================
# WEBSOCKET CONFIGURATION
# ================================================

# WebSocket client host
REACT_APP_WS_CLIENT_HOST=localhost

# WebSocket client port
REACT_APP_WS_CLIENT_PORT=8080

# WebSocket server host
REACT_APP_WS_SERVER_HOST=localhost

# WebSocket server port
REACT_APP_WS_SERVER_PORT=8080

# ================================================
# TRACKER SERVICE CONFIGURATION
# ================================================

# Tracker service port
REACT_APP_TRACKER_PORT=8080

# Tracker client port
REACT_APP_TRACKER_CLIENT=3001

# Tracker Server Go port
REACT_APP_TRACKER_SERVER_GO_PORT=8080

# Tracker Client Go port
REACT_APP_TRACKER_CLIENT_GO_PORT=8081

# Tracker Analytics port
REACT_APP_TRACKER_ANALYTICS_PORT=5050

# ================================================
# MQTT CONFIGURATION
# ================================================

# MQTT WebSocket URL
REACT_APP_MQTT_WS_URL=ws://localhost:9001/mqtt

# ================================================
# GOOGLE MAPS CONFIGURATION
# ================================================

# Google Maps API Key
# ⚠️  IMPORTANT SECURITY NOTE:
# This key will be visible in the browser (client-side).
# You MUST restrict this key in Google Cloud Console:
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Select your API key
# 3. Under "Application restrictions", select "HTTP referrers (websites)"
# 4. Add your domain(s): e.g., https://yourdomain.com/*
# 5. Under "API restrictions", select "Maps JavaScript API" only
# 6. Save changes
# This prevents unauthorized use of your key on other websites.
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ================================================
# DEVELOPMENT ONLY
# These are set at build time and cannot be changed at runtime
# ================================================
# NODE_ENV=development
# PORT=3000
